# Tuya IoT Platform Credentials
# Get these from https://iot.tuya.com/
# 1. Create account and project
# 2. Subscribe to necessary APIs (IoT Core, Authorization)
# 3. Copy Access ID and Access Key from your project
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_KEY=your_access_key_here

# API Endpoint (choose based on your region)
# EU: https://openapi.tuyaeu.com
# US: https://openapi.tuyaus.com
# CN: https://openapi.tuyacn.com
# IN: https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# Prometheus Pushgateway URL
PUSHGATEWAY_URL=https://pushgateway.example.com

# Data collection interval (seconds)
INTERVAL=60
